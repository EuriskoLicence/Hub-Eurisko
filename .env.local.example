# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="HR Portal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Ottieni il connection string da: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Cloudflare R2 (S3-compatible) ───────────────────────────────────────────
# Crea un bucket su: https://dash.cloudflare.com → R2
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="hr-portal-dev"
# URL pubblico del bucket (se abilitato) oppure lascia vuoto per usare solo presigned URL
R2_PUBLIC_URL=""

# ─── Resend (email) ───────────────────────────────────────────────────────────
# Ottieni la API key da: https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM="noreply@azienda.it"

# ─── Email HR Finance (destinatario notifiche rettifica) ──────────────────────
HR_FINANCE_EMAIL="hrfinance@azienda.it"

# ─── Admin di default (usato dal seed) ───────────────────────────────────────
ADMIN_EMAIL="admin@azienda.it"
ADMIN_PASSWORD="changeme123"
