# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=HR Portal
NEXT_PUBLIC_APP_URL=https://tuo-dominio.vercel.app

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=genera-con-openssl-rand-base64-32
NEXTAUTH_URL=https://tuo-dominio.vercel.app

# ─── Cloudflare R2 (S3-compatible) ───────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=noreply@tuo-dominio.com

# ─── Email HR Finance ─────────────────────────────────────────────────────────
HR_FINANCE_EMAIL=finance@tuo-dominio.com

# ─── Admin di default (solo per seed iniziale) ────────────────────────────────
ADMIN_EMAIL=admin@tuo-dominio.com
ADMIN_PASSWORD=
